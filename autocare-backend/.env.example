# Copy this file to ".env" and fill in your own values.
# The .env file holds secrets. Never commit it or share it.

PORT=3000
# Address of the frontend (comma-separate several). Vite's default is shown.
FRONTEND_URL=http://localhost:5173

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# TiDB Cloud: open your cluster, click "Connect", and copy these values.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=vehiclecare
# TiDB Cloud needs TLS, so keep this true. Use false only for a local MySQL.
DB_SSL=true

# ---------------------------------------------------------------------------------
# Forgot password: how the 6-digit code is emailed
# ---------------------------------------------------------------------------------
# While you build and test, leave ALL of these empty. The code is then printed in the
# terminal where "npm start" runs, and no email is sent.
#
# Option A, testing on your PC: Gmail with an App Password (needs 2-Step Verification)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=the 16-character app password
#   MAIL_FROM=AutoCARe <yourname@gmail.com>
#
# Option B, needed on Render's free plan (it blocks SMTP): Brevo over HTTPS
#   BREVO_API_KEY=your Brevo API key
#   MAIL_FROM=AutoCARe <an address you verified in Brevo>
#
# Test your setup with:  npm run test-email -- you@example.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=

# ---------------------------------------------------------------------------------
# Only when deployed (for example on Render)
# ---------------------------------------------------------------------------------
# NODE_ENV=production   -> reset codes are never printed in the logs
# TRUST_PROXY=1         -> the server sits behind one proxy, so rate limits see the real visitor
